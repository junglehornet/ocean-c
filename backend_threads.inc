// Native bridges share the existing Ocean closure and defer ABIs.
static void emitThreadRuntime(Backend *b) {
    if (!b->threadsUsed) return;
    fputs(
        "@ocean_runtime_thread_name = private constant [7 x i8] c\"thread\\00\"\n"
        "@ocean_runtime_thread_file = private constant [9 x i8] c\"<thread>\\00\"\n"
        "declare i64 @ocean_threads_spawn(ptr, ptr)\n"
        "declare void @ocean_threads_checkpoint()\n"
        "declare void @ocean_threads_panic_exit(i32) noreturn\n"
        "declare void @ocean_threads_begin_return()\n"
        "declare void @ocean_threads_exit() noreturn\n"
        "; These C ABI bridges are defined once in program support, not in library code.\n"
        "define hidden void @ocean_runtime_thread_invoke(ptr %code, ptr %environment) {\n"
        "entry:\n"
        "  %trace = alloca %__ocean.trace, align 8\n"
        "  store %__ocean.trace { ptr null, ptr @ocean_runtime_thread_name, ptr @ocean_runtime_thread_file, i64 0, i64 0, ptr null, i1 false }, ptr %trace\n"
        "  store ptr %trace, ptr @__ocean.trace_head\n"
        "  call void %code(ptr %environment)\n"
        "  store ptr null, ptr @__ocean.trace_head\n"
        "  ret void\n"
        "}\n"
        "define hidden void @ocean_runtime_closure_init() {\n"
        "entry:\n"
        "  %registration = call ptr @__ocean.closure_alloc(i64 0, ptr null)\n"
        "  ret void\n"
        "}\n"
        "define hidden i32 @ocean_runtime_can_cancel() {\n"
        "entry:\n"
        "  ; Never interrupt an active deferred cleanup or panic recovery context.\n"
        "  %context = load ptr, ptr @__ocean.recovery_head\n"
        "  %allowed = icmp eq ptr %context, null\n"
        "  %result = zext i1 %allowed to i32\n"
        "  ret i32 %result\n"
        "}\n"
        "define hidden void @ocean_runtime_thread_return() noreturn {\n"
        "entry:\n"
        "  call void @ocean_threads_begin_return()\n"
        "  br label %loop\n"
        "loop:\n"
        "  %frame = load ptr, ptr @__ocean.defer_head\n"
        "  %present = icmp ne ptr %frame, null\n"
        "  br i1 %present, label %unwind, label %done\n"
        "unwind:\n"
        "  call void @__ocean.abandon_capture(ptr %frame)\n"
        "  %ignored = call i1 @__ocean.run_defers(ptr %frame, ptr null, i64 0, i1 false)\n"
        "  call void @__ocean.discard_defers(ptr %frame)\n"
        "  call void @__ocean.finish_recovery(ptr %frame)\n"
        "  br label %loop\n"
        "done:\n"
        "  call void @ocean_threads_exit()\n"
        "  unreachable\n"
        "}\n"
        , b->out);
}
