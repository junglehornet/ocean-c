# Run for each build so commits and build dates never depend on reconfiguration.
find_package(Git QUIET)
if(GIT_FOUND)
    foreach(field IN ITEMS COMMIT COMMIT_DATE COMMIT_YEAR)
        if(NOT "${OCEAN_${field}}" STREQUAL "")
            continue()
        endif()
        if(field STREQUAL "COMMIT")
            set(format "%H")
        elseif(field STREQUAL "COMMIT_DATE")
            set(format "%cs")
        else()
            set(format "%cd")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 "--format=${format}" --date=format:%Y
            WORKING_DIRECTORY "${OCEAN_SOURCE_DIR}"
            RESULT_VARIABLE result OUTPUT_VARIABLE value
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(result EQUAL 0 AND NOT value STREQUAL "")
            set(OCEAN_${field} "${value}")
        endif()
    endforeach()
endif()
foreach(field IN ITEMS COMMIT COMMIT_DATE COMMIT_YEAR)
    if("${OCEAN_${field}}" STREQUAL "")
        set(OCEAN_${field} "unknown")
    endif()
endforeach()
if("${OCEAN_BUILD_DATE}" STREQUAL "")
    string(TIMESTAMP OCEAN_BUILD_DATE "%Y-%m-%dT%H:%M:%SZ" UTC)
endif()
set(header "/* Generated build metadata. */\n")
foreach(field IN ITEMS VERSION COMMIT COMMIT_DATE COMMIT_YEAR BUILD_DATE)
    set(value "${OCEAN_${field}}")
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(APPEND header "#define OCEAN_${field} \"${value}\"\n")
endforeach()
file(WRITE "${OCEAN_BINARY_DIR}/ocean_build_info.h.tmp" "${header}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "${OCEAN_BINARY_DIR}/ocean_build_info.h.tmp" "${OCEAN_BINARY_DIR}/ocean_build_info.h"
    COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OCEAN_BINARY_DIR}/ocean_build_info.h.tmp")
