func fill(values int[]) {
    for (i := 0; i < len(values); i++) {
        values.data[i] = i + 1;
    }
}

func main() int {
    arr: int[] = int[5];
    arr.data = {9, 8};
    fill(arr);
    if (len(arr) != 5) { return 1; }
    if (arr.size != 5 * sizeof(int)) { return 2; }
    return arr[4] - 5;
}
