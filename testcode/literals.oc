func sum(values int[]) int {
    total := 0;
    for (i := 0; i < len(values); i++) {
        total += values[i];
    }
    return total;
}

func pairSum(values buffer<int>[]) int {
    return values[0] + values[1];
}

func main() int {
    values: int[] = {1, 2, 3};
    values = {4, 5};
    fixed: buffer<int>[3] = {6, 7};
    total := sum(int[]{1, 2, 3});
    other := pairSum(buffer<int>{4, 5});
    return len(values) + fixed[2] + total + other - 17;
}
