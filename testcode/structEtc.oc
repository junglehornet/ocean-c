package main;

import "io";

struct Color {
    red, green, blue, alpha u8;
}

enum MazeObjType {
    PLAYER, WALL, TRAP, NONE,
}

struct MazeObj {
    dispColor Color;
    kind MazeObjType;
}

// Value parameters are immutable fields, followed by ordinary mutable fields.
// Nested dynamic arrays own their rows; access them through the named field.
struct Matrix<T>(width, height int) {
    underlying T[][];
}

// Custom struct operations use named receiver methods.
func (matrix *Matrix<T>) Fill(value T) {
    for (row := 0; row < len(matrix.underlying); row++) {
        for (col := 0; col < len(matrix.underlying[row]); col++) {
            matrix.underlying[row][col] = value;
        }
    }
}

type Maze = Matrix<MazeObj>;

func main() int {
    matrix := Matrix<int>{2, 2, {{1, 2}, {3, 4}}};
    matrix.Fill(5);
    if (matrix.underlying[0][0] != 5 || matrix.underlying[1][1] != 5) {
        return 1;
    }

    player := MazeObj{Color{255, 0, 0, 255}, MazeObjType.PLAYER};
    maze := Maze{1, 1, {{player}}};
    maze.Fill(player);
    io.Printf("Matrix dimensions: {} by {}\n", matrix.width, matrix.height);
    return 0;
}
