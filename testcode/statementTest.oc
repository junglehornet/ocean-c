package main;

import "io";

func main() {
    x: int = 2;
    // Inner declarations may shadow outer bindings.
    if (x == 2) {
        x := 4;
        if (x == 4) io.Println("Inner x is 4");
    }

    for (true) {
        io.Println("Hello there");
        break;
    }

    true_or_false: bool = true;
    for (true_or_false) {
        io.Println("Hello there #2");
        break;
    }

    for (i := 2; i < 5; i++) {
        io.Println("This should print 3 times");
    }

    for (;false;) {
        io.Println("never runs :(");
    }

    // An empty three-part header loops until an explicit break.
    for (;;) {
        io.Println("An unconditional loop");
        break;
    }

    // A deferred condition skips the first condition check.
    for (defer false) {
        io.Println("This do-while loop runs once.");
    }

    for (i := 0; defer i > 0; i--) {
        io.Println("This do-for loop runs once, then updates i before checking.");
    }
}
