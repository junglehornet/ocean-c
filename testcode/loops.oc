import (
    "io"
    "rand"
);

func main() {
    // basic for loop
    for (x := 0; x < 5; x++) io.Printf("x = %d\n", x);

    // while loop
    y := 0;
    for (y < 3) {
        io.Printf("y = %d\n", y);
        y++;
    }

    // range loop
    numbers := {5, 4, 3, 2, 1};
    for (i, value := range numbers) {
        io.Printf("numbers[%d] = %d\n", i, value);
    }

    // do-while
    z := 0;
    for (defer x != 0) {
        z = rand.Randint(0, 5);
        io.Println(z);
    }

    // do-for
    for (a := 10; defer a < 10 && a > 0; a--) {
        io.Println(a);
    }
}