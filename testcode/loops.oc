package main;

import "io";

func main() {
    // basic for loop
    for (x := 0; x < 5; x++) io.Printf("x = {}\n", x);

    // while loop
    y := 0;
    for (y < 3) {
        io.Printf("y = {}\n", y);
        y++;
    }

    // range loop
    numbers := {5, 4, 3, 2, 1};
    for (i, value := range numbers) {
        io.Printf("numbers[{}] = {}\n", i, value);
    }

    // do-while
    z := 3;
    for (defer z != 0) {
        z--;
        io.Println(z);
    }

    // do-for
    for (a := 10; defer a < 10 && a > 0; a--) {
        io.Println(a);
    }
}
